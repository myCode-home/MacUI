<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- macOS 深色玻璃 -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F2F2F7"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99EBEBF5"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#3AFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF453A"/>
    <SolidColorBrush x:Key="DotBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#E8202228"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="SwitcherBgBrush" Color="#12141414"/>
    <SolidColorBrush x:Key="SwitcherBorderBrush" Color="#22FFFFFF"/>
</ResourceDictionary>
