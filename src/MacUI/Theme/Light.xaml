<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- macOS 浅色玻璃 -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8A3C3C43"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#30000000"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#24000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF007AFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF3B30"/>
    <SolidColorBrush x:Key="DotBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#20000000"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#F2F4F4F6"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#22000000"/>
    <SolidColorBrush x:Key="SwitcherBgBrush" Color="#1A141414"/>
    <!-- 控制中心/面板底:浅色 iOS 磨砂 -->
    <SolidColorBrush x:Key="PanelBgBrush" Color="#33F2F2F7"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#30000000"/>
    <SolidColorBrush x:Key="SwitcherBorderBrush" Color="#22FFFFFF"/>
</ResourceDictionary>
