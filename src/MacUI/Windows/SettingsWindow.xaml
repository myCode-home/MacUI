<Window x:Class="MacUI.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacUI 设置" Height="430" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource TrackBrush}"
        FontFamily="{StaticResource UIFont}">
    <Grid Margin="20,16,20,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <TextBlock Text="顶部状态栏" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="ChkStatus" Style="{StaticResource CfgCheck}"
                      Content="启用状态栏(鼠标顶到屏幕上缘时滑出)"/>

            <TextBlock Text="Spotlight 搜索" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="ChkSpotlight" Style="{StaticResource CfgCheck}"
                      Content="启用 Spotlight(全局热键呼出)"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="热键:" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                <TextBox x:Name="HotkeyBox" Height="30" Width="130" FontSize="12"
                         VerticalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="⚠️ 该热键为全局接管:默认的 Ctrl+Space 会覆盖系统中英文输入法切换,可改为 Alt+Space 等。"
                       FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,4"/>

            <TextBlock Text="外观" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="主题:" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,8,0"/>
                <ComboBox x:Name="ThemeBox" Height="30" Width="120" FontSize="12">
                    <ComboBoxItem Content="跟随系统" Tag="system"/>
                    <ComboBoxItem Content="深色" Tag="dark"/>
                    <ComboBoxItem Content="浅色" Tag="light"/>
                </ComboBox>
                <TextBlock Text="收回延迟:" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="18,0,8,0"/>
                <TextBox x:Name="DelayBox" Height="30" Width="70" FontSize="12"
                         VerticalContentAlignment="Center"/>
                <TextBlock Text="ms" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="4,0,0,0"/>
            </StackPanel>

            <TextBlock Text="其他" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="ChkAutostart" Style="{StaticResource CfgCheck}" Content="开机自启动"/>

            <Button x:Name="BtnApply" Content="应用并保存" Height="34" Width="120"
                    HorizontalAlignment="Right" Margin="0,14,0,0"
                    Click="BtnApply_Click" Cursor="Hand"
                    FontWeight="SemiBold"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
