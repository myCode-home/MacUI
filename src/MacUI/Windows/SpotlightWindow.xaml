<Window x:Class="MacUI.Windows.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight" Height="440" Width="660"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False"
        FontFamily="{StaticResource UIFont}"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" CornerRadius="14" Margin="8">
        <StackPanel>
            <Grid Margin="20,16,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="22"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="22"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>
            <Separator Background="Transparent" BorderThickness="0,1,0,0"
                       BorderBrush="{DynamicResource DividerBrush}" Margin="12,0"/>
            <ListBox x:Name="Results" Style="{StaticResource FlatList}"
                     MaxHeight="330" Margin="10,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     MouseLeftButtonUp="Results_Click"
                     KeyDown="Results_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="26" Height="26"
                                   VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="14"
                                           Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="{Binding Sub}" FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Padding="16,8,16,12">
                <TextBlock Text="↑↓ 选择    ↵ 打开    Esc 关闭" FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           HorizontalAlignment="Right"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
