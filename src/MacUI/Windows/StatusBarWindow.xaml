<Window x:Class="MacUI.Windows.StatusBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StatusBar" Height="30" Width="400"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False" Visibility="Collapsed"
        FontFamily="{StaticResource UIFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Padding="12,0">
        <Grid>
            <!-- 左侧:输入法 + 运行中应用图标 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border CornerRadius="8" Padding="6,1" Margin="0,0,8,0"
                        Background="{DynamicResource TrackBrush}">
                    <TextBlock x:Name="ImeText" Text="中" FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                </Border>
                <StackPanel x:Name="AppsRow" Orientation="Horizontal" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 右侧:网络 / 音量 / 电量 / 时间 / 设置 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="NetIcon" FontFamily="{StaticResource IconFont}" Text="&#xE701;"
                           FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="VolumeIcon" FontFamily="{StaticResource IconFont}" Text="&#xE767;"
                           FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="VolumeText" Text="80%" FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock x:Name="BatteryIcon" FontFamily="{StaticResource IconFont}" Text="&#xE850;"
                           FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="BatteryText" Text="100%" FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" Margin="4,0,12,0"/>
                <TextBlock x:Name="TimeText" Text="00:00" FontSize="12.5"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="GearBtn" Style="{StaticResource IconBtn}" Content="&#xE713;"
                        FontSize="13" VerticalAlignment="Center" Click="Gear_Click"
                        ToolTip="设置"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
