<Window x:Class="MacUI.Windows.AppSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppSwitcher" Height="108" Width="760"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource UIFont}"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" CornerRadius="28" Margin="4"
            Background="{DynamicResource SwitcherBgBrush}"
            BorderThickness="0">
        <StackPanel x:Name="Row" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
</Window>
