<Window x:Class="MacUI.Windows.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlCenter" Width="340"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource UIFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- macOS / iOS 系统色 -->
        <SolidColorBrush x:Key="SysBlue" Color="#0A84FF"/>
        <SolidColorBrush x:Key="SysPurple" Color="#BF5AF2"/>
        <SolidColorBrush x:Key="SysGreen" Color="#30D158"/>
        <SolidColorBrush x:Key="SysOrange" Color="#FF9F0A"/>

        <!-- 卡片 -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="ClickTile" TargetType="Border" BasedOn="{StaticResource Tile}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 彩色图标块 -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="ChipGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="TileHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- iOS 细轨道滑条 -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="16" Height="16">
                            <Ellipse Fill="#33000000" Margin="0,1,0,0"/>
                            <Ellipse Fill="White"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MacSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{DynamicResource TrackBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}"
                                                  Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderEmpty}"
                                                  Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 动画 = 原生 SetWindowPos 改窗口真实尺寸,DWM 磨砂跟着窗口走(SetWindowRgn 裁不住磨砂层)。
         Viewbox 让内容随窗口等比缩放。不用 WPF Width/Height 属性动画(会被系统回吞) -->
    <Viewbox x:Name="ScaleHost" Stretch="Fill" StretchDirection="Both">
        <Border x:Name="Root" Width="340" CornerRadius="24"
                BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                Background="{DynamicResource PanelBgBrush}">
            <StackPanel x:Name="ContentPanel" Margin="15">
                <!-- 时钟 -->
                <Border Style="{StaticResource Tile}" Padding="16,12" Margin="0,0,0,9">
                    <StackPanel>
                        <TextBlock x:Name="CcTime" Text="00:00" FontSize="36" FontWeight="Light"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock x:Name="CcDate" Text="" FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 音量 -->
                <Border Style="{StaticResource Tile}" Margin="0,0,0,9">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Chip}" Background="{StaticResource SysBlue}">
                                <TextBlock Text="&#xE767;" Style="{StaticResource ChipGlyph}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="音量" Style="{StaticResource TileLabel}"/>
                            <TextBlock Grid.Column="2" x:Name="VolText" Text="-" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="VolSlider" Style="{StaticResource MacSlider}"
                                Minimum="0" Maximum="100" Margin="0,9,0,0"
                                IsMoveToPointEnabled="True"/>
                    </StackPanel>
                </Border>

                <!-- 主题 + 网络 -->
                <UniformGrid Columns="2" Rows="1" Margin="0,0,0,9">
                    <Border x:Name="ThemeTile" Style="{StaticResource ClickTile}" Margin="0,0,4,0"
                            MouseLeftButtonUp="ThemeTile_Click" ToolTip="切换 Windows 深色/浅色模式">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Chip}" Background="{StaticResource SysPurple}">
                                    <TextBlock Text="&#xE706;" Style="{StaticResource ChipGlyph}"/>
                                </Border>
                                <TextBlock Text="主题" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                            <TextBlock x:Name="ThemeState" Text="深色" Style="{StaticResource TileValue}"/>
                            <TextBlock Text="切换系统深/浅色" Style="{StaticResource TileHint}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NetTile" Style="{StaticResource ClickTile}" Margin="4,0,0,0"
                            MouseLeftButtonUp="NetTile_Click" ToolTip="打开系统网络适配器设置">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Chip}" Background="{StaticResource SysGreen}">
                                    <TextBlock Text="&#xE701;" Style="{StaticResource ChipGlyph}"/>
                                </Border>
                                <TextBlock Text="网络" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                            <TextBlock x:Name="NetText" Text="-" Style="{StaticResource TileValue}"/>
                            <TextBlock x:Name="NetHint" Text="打开网络设置" Style="{StaticResource TileHint}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 显示桌面 + 电量 -->
                <UniformGrid Columns="2" Rows="1">
                    <Border x:Name="DesktopTile" Style="{StaticResource ClickTile}" Margin="0,0,4,0"
                            MouseLeftButtonUp="DesktopTile_Click" ToolTip="最小化所有窗口,显示桌面">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Chip}" Background="{StaticResource SysOrange}">
                                    <TextBlock Text="&#xE740;" Style="{StaticResource ChipGlyph}"/>
                                </Border>
                                <TextBlock Text="桌面" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                            <TextBlock Text="显示桌面" Style="{StaticResource TileValue}"/>
                            <TextBlock Text="最小化全部窗口" Style="{StaticResource TileHint}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}" Margin="4,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="BatChip" Style="{StaticResource Chip}" Background="{StaticResource SysGreen}">
                                    <TextBlock x:Name="BatIcon" Text="&#xE850;" Style="{StaticResource ChipGlyph}"/>
                                </Border>
                                <TextBlock Text="电量" Style="{StaticResource TileLabel}"/>
                            </StackPanel>
                            <TextBlock x:Name="BatText" Text="-" Style="{StaticResource TileValue}"/>
                            <Grid x:Name="BatFrame" Height="6" Margin="0,3,0,1">
                                <Border CornerRadius="3" Background="{DynamicResource TrackBrush}"/>
                                <Border x:Name="BatBar" CornerRadius="3" HorizontalAlignment="Left"
                                        Background="{StaticResource SysGreen}" Width="0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>
