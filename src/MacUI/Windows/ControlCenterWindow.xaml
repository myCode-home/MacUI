<Window x:Class="MacUI.Windows.ControlCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControlCenter" Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource UIFont}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" CornerRadius="24" Margin="8"
            Background="{DynamicResource SwitcherBgBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <StackPanel Margin="14">
            <!-- 时钟 -->
            <Border CornerRadius="16" Padding="14,10" Margin="0,0,0,10"
                    Background="{DynamicResource TrackBrush}">
                <StackPanel>
                    <TextBlock x:Name="CcTime" Text="00:00" FontSize="34" FontWeight="Light"
                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="CcDate" Text="" FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 音量 + 主题 -->
            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,10">
                <Border CornerRadius="16" Padding="12,10" Margin="0,0,5,0"
                        Background="{DynamicResource TrackBrush}">
                    <StackPanel>
                        <TextBlock Text="音量" FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="VolText" Text="-" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,6"/>
                        <Slider x:Name="VolSlider" Minimum="0" Maximum="100"
                                Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="16" Padding="12,10" Margin="5,0,0,0"
                        Background="{DynamicResource TrackBrush}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="主题" FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button x:Name="ThemeBtn" Content="切换" Height="30" Margin="0,6,0,0"
                                Cursor="Hand" Click="ThemeBtn_Click"
                                Background="{DynamicResource HoverBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderThickness="0" FontSize="12.5"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 网络 + 显示桌面 -->
            <UniformGrid Columns="2" Rows="1" Margin="0,0,0,10">
                <Border CornerRadius="16" Padding="12,10" Margin="0,0,5,0"
                        Background="{DynamicResource TrackBrush}">
                    <StackPanel>
                        <TextBlock Text="网络" FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock x:Name="NetText" Text="-" FontSize="13"
                                   Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="16" Padding="12,10" Margin="5,0,0,0"
                        Background="{DynamicResource TrackBrush}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="桌面" FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <Button x:Name="DesktopBtn" Content="显示桌面" Height="30" Margin="0,6,0,0"
                                Cursor="Hand" Click="DesktopBtn_Click"
                                Background="{DynamicResource HoverBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderThickness="0" FontSize="12.5"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 电量 -->
            <Border CornerRadius="16" Padding="14,10"
                    Background="{DynamicResource TrackBrush}">
                <StackPanel>
                    <TextBlock Text="电量" FontSize="11.5"
                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                        <TextBlock x:Name="BatIcon" Text="&#xE850;" FontFamily="{StaticResource IconFont}"
                                   FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="BatText" Text="-" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Grid x:Name="BatFrame">
                        <Border Height="6" CornerRadius="3"
                                Background="{DynamicResource TrackBrush}"/>
                        <Border x:Name="BatBar" Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}" Width="0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
